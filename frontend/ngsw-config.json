{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/auth/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "covers",
      "urls": ["/api/covers/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 1000, "maxAge": "365d" }
    },
    {
      "name": "collection-offline",
      "urls": [
        "/api/me",
        "/api/collection",
        "/api/collection?**",
        "/api/collection/*",
        "/api/collection/stats",
        "/api/wishlist"
      ],
      "cacheConfig": { "strategy": "freshness", "maxSize": 300, "maxAge": "30d", "timeout": "5s" }
    }
  ]
}
