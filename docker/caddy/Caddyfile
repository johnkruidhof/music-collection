{
	# Eigen lokale CA voor thuisgebruik (ook voor IP-adressen).
	# Bij publiek online gaan: deze regel weghalen en APP_HOST op een echt domein zetten,
	# dan haalt Caddy automatisch een Let's Encrypt-certificaat op.
	local_certs

	# Bij een IP-adres sturen browsers geen SNI mee; zonder dit kiest Caddy geen certificaat
	# en faalt de TLS-handshake ("internal error").
	default_sni {$APP_HOST:localhost}
}

{$APP_HOST:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
