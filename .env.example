# Kopieer naar .env en pas aan. .env staat in .gitignore.

# Hostnaam of IP-adres waarop de app bereikbaar is.
#  - alleen op deze computer (en voor ng serve):  localhost
#  - ook met je telefoon scannen:                 het IP-adres van deze computer, bijv. 192.168.1.50
APP_HOST=localhost

# Postgres superuser
POSTGRES_PASSWORD=change-me

# Database-gebruikers (worden bij de eerste start aangemaakt).
# 'music' komt overeen met de standaard in application.yml, handig bij starten vanuit IntelliJ.
APP_DB_PASSWORD=music
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak-beheerder (https://<APP_HOST>/auth/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Discogs personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
